# Copy to .env and fill in values for live local ADK / cloud deployment.
# Offline tests do not require any of these variables.

# --- Gemini / Vertex configuration ---
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_MODEL=gemini-2.0-flash
GOOGLE_GENAI_USE_VERTEXAI=true

# Optional alternative to Vertex: Google AI Studio key
# GOOGLE_GENAI_USE_VERTEXAI=false
# GOOGLE_API_KEY=your-ai-studio-api-key

# --- Agent Runtime (Agent Engine) deployment ---
# Optional legacy staging bucket (adk deploy agent_engine no longer requires it)
# STAGING_BUCKET=gs://your-staging-bucket

# Paste the reasoningEngine resource name after deploy_agent_runtime.py
AGENT_ENGINE_RESOURCE_NAME=projects/your-project/locations/us-central1/reasoningEngines/your-id
